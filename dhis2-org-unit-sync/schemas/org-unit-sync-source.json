{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org-unit-sync-source",
  "title": "Organisation units, as the source instance hands them over",
  "description": "The rows of an organisationUnits read projected to the fields a metadata import needs, with every identifier held to the pack's dhis2-uid format and every code to dhis2-code. A unit with no parent is a root, and a root does not travel: the projection requires one.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "code", "name", "shortName", "openingDate", "level", "parent"],
    "properties": {
      "id": { "type": "string", "format": "dhis2-uid" },
      "code": { "type": "string", "format": "dhis2-code" },
      "name": { "type": "string", "minLength": 1 },
      "shortName": { "type": "string", "minLength": 1, "maxLength": 50 },
      "openingDate": { "type": "string", "minLength": 1 },
      "level": { "type": "integer", "minimum": 2 },
      "parent": {
        "type": "object",
        "required": ["id", "code"],
        "properties": {
          "id": { "type": "string", "format": "dhis2-uid" },
          "code": { "type": "string", "format": "dhis2-code" }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}

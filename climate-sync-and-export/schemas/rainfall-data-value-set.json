{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rainfall-data-value-set",
  "title": "Rainfall, as a DHIS2 dataValueSet",
  "description": "The dataValueSet the rainfall-daily export renders: one value per org unit and day, every identifier held to the dhis2 pack's dhis2-uid format and every period to dhis2-period.",
  "type": "object",
  "required": ["dataValues"],
  "properties": {
    "dataValues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dataElement", "orgUnit", "period", "value"],
        "properties": {
          "dataElement": { "type": "string", "format": "dhis2-uid" },
          "orgUnit": { "type": "string", "format": "dhis2-uid" },
          "period": { "type": "string", "format": "dhis2-period" },
          "value": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?([eE]-?[0-9]+)?$" }
        }
      }
    }
  }
}

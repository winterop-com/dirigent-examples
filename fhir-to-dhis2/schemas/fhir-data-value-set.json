{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fhir-data-value-set",
  "title": "A FHIR form response, as a DHIS2 dataValueSet",
  "description": "The envelope one QuestionnaireResponse translates into: a data set, an org unit and a period, and at least one value, every identifier held to the dhis2 pack's dhis2-uid format and the period to dhis2-period.",
  "type": "object",
  "required": ["dataSet", "orgUnit", "period", "dataValues"],
  "properties": {
    "dataSet": { "type": "string", "format": "dhis2-uid" },
    "orgUnit": { "type": "string", "format": "dhis2-uid" },
    "period": { "type": "string", "format": "dhis2-period" },
    "dataValues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dataElement", "value"],
        "properties": {
          "dataElement": { "type": "string", "format": "dhis2-uid" },
          "categoryOptionCombo": { "type": "string", "format": "dhis2-uid" },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unanswered": { "type": "array", "items": { "type": "string" } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org-unit-sync-import",
  "title": "The organisation units a metadata import may carry",
  "description": "A /api/metadata payload of organisation units. DHIS2 requires name, shortName, openingDate and a parent of every unit below the root, and matches each one by uid or by code according to the import's identifier parameter -- so an identifier is required to be present and held to its format, and which of the two it is is the request's business rather than the shape's.",
  "type": "object",
  "required": ["organisationUnits"],
  "properties": {
    "organisationUnits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "shortName", "openingDate", "parent"],
        "anyOf": [{ "required": ["id"] }, { "required": ["code"] }],
        "properties": {
          "id": { "type": "string", "format": "dhis2-uid" },
          "code": { "type": "string", "format": "dhis2-code" },
          "name": { "type": "string", "minLength": 1 },
          "shortName": { "type": "string", "minLength": 1, "maxLength": 50 },
          "openingDate": { "type": "string", "minLength": 1 },
          "parent": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "id": { "type": "string", "format": "dhis2-uid" },
              "code": { "type": "string", "format": "dhis2-code" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
